{% comment %}
  Simplified product media gallery - shows only main product image
{% endcomment %}

<div class="product-single__media-wrapper">
  <div class="product-single__media">
    {% assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media %}
    
    {% if featured_media %}
      <div class="product-single__media-item" data-media-id="{{ featured_media.id }}">
        <img 
          src="{{ featured_media | img_url: '1000x' }}"
          alt="{{ featured_media.alt | escape }}"
          class="product-single__image"
          loading="lazy"
          width="1000"
          height="{{ 1000 | divided_by: featured_media.aspect_ratio | round }}"
        >
      </div>
    {% else %}
      <div class="product-single__media-item">
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {% endif %}
  </div>
</div>