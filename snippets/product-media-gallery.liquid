{% comment %}
  Renders a simplified product media gallery with only the main image
  Accepts:
  - product: {Object} Product object
  - variant_images: {Array} Variant images for the product
{% endcomment %}

<div id="ProductGallery-{{ section.id }}" class="product__media-gallery">
  <div class="product__media-wrapper">
    <div class="product__media product__media--single">
      {% assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media %}
      
      {% if featured_media %}
        <div class="product__media-item" data-media-id="{{ featured_media.id }}">
          {% render 'product-media', media: featured_media %}
        </div>
      {% else %}
        <div class="product__media-item product__media-item--empty">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {% endif %}
    </div>
  </div>
</div>