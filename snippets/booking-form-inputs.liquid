<script>
document.addEventListener('DOMContentLoaded', function() {
  // Configuration
  const imageMapping = {
    // Equipment only
    "1U2C-No": "2C1UYes", // 1 Umbrella 2 Chair No Cooler
    "1U1C-No": "1C1UYes", // 1 Umbrella 1 Chair No Cooler
    "2C-No": "2C",        // 2 Chair No Cooler
    "1C-No": "1C",        // 1 Chair No Cooler
    "1U-No": "1U",        // 1 Umbrella No Cooler
    "None-No": "None",    // Just Cart No Cooler
    
    // With cooler
    "1U2C-Yes": "2C1UYes", // 1 Umbrella 2 Chair With Cooler
    "1U1C-Yes": "1C1UYes", // 1 Umbrella 1 Chair With Cooler
    "2C-Yes": "2CYes",     // 2 Chair With Cooler
    "1C-Yes": "1CYes",     // 1 Chair With Cooler
    "1U-Yes": "1UYes",     // 1 Umbrella With Cooler
    "None-Yes": "Yes"      // Just Cart With Cooler
  };
  
  // Base prices
  const basePrices = {
    "1U2C": 110.00,
    "1U1C": 96.00,
    "2C": 96.00,
    "1C": 89.00,
    "1U": 89.00,
    "None": 82.00
  };
  
  // Cooler price addition
  const coolerAdds = {
    "Yes": 7.00,
    "No": 0.00
  };
  
  // Discount tiers based on duration
  const discountTiers = {
    1: 1.00, // No discount
    2: 0.90, // 10% discount
    3: 0.80  // 20% discount
  };
  
  // State variables
  let selectedEquipment = "None";
  let selectedCooler = "No";
  let selectedDates = [];
  let selectionMode = 'start';
  let currentDate = new Date();
  
  // DOM elements
  const calendarEl = document.getElementById('calendar');
  const currentMonthEl = document.getElementById('current-month');
  const selectionStatusEl = document.getElementById('selection-status');
  const selectedDateRangeEl = document.getElementById('selected-date-range');
  const displayedPriceEl = document.getElementById('displayed-price');
  const priceBreakdownEl = document.getElementById('price-breakdown');
  
  // Hidden inputs
  const equipmentInput = document.getElementById('equipment-input');
  const coolerInput = document.getElementById('cooler-input');
  const startDateInput = document.getElementById('start-date-input');
  const endDateInput = document.getElementById('end-date-input');
  const durationInput = document.getElementById('duration-input');
  const discountInput = document.getElementById('discount-input');
  const basePriceInput = document.getElementById('base-price-input');
  const totalPriceInput = document.getElementById('total-price-input');
  
  // ---- Disable image magnification globally ----
  function disableImageZoom() {
    // Remove zoom containers
    document.querySelectorAll('.zoomContainer, .zoom-container, .pswp, .pswp--open').forEach(el => {
      if (el && el.parentNode) {
        el.parentNode.removeChild(el);
      }
    });
    
    // Disable zoom on all product images
    document.querySelectorAll('.product__img, .product-single__photo, .product-featured-img, .product__media img').forEach(img => {
      if (img) {
        // Remove zoom attributes
        img.removeAttribute('data-zoom');
        img.removeAttribute('data-zoom-image');
        img.removeAttribute('data-image-zoom');
        
        // Add no-zoom classes
        img.classList.add('no-magnify');
        img.style.cursor = 'default';
        
        // Fix parent container
        const container = img.closest('.product__media, .product-single__photo-wrapper');
        if (container) {
          container.style.overflow = 'visible';
          container.classList.remove('zoom-container');
        }
      }
    });
  }
  
  // Run on page load and periodically check
  disableImageZoom();
  setInterval(disableImageZoom, 1000); // Check every second for new zoom elements
  
  // Setup equipment selection
  const equipmentButtons = document.querySelectorAll('.equipment-options .option-button');
  equipmentButtons.forEach(button => {
    button.addEventListener('click', function() {
      equipmentButtons.forEach(btn => btn.classList.remove('selected'));
      this.classList.add('selected');
      selectedEquipment = this.getAttribute('data-equipment');
      equipmentInput.value = selectedEquipment;
      updateBasePrice();
      updateProductImage();
    });
  });
  
  // Setup cooler selection
  const coolerButtons = document.querySelectorAll('.cooler-options .option-button');
  coolerButtons.forEach(button => {
    button.addEventListener('click', function() {
      coolerButtons.forEach(btn => btn.classList.remove('selected'));
      this.classList.add('selected');
      selectedCooler = this.getAttribute('data-cooler');
      coolerInput.value = selectedCooler;
      updateBasePrice();
      updateProductImage();
    });
  });
  
  // Setup calendar navigation
  document.getElementById('prev-month').addEventListener('click', () => {
    currentDate.setMonth(currentDate.getMonth() - 1);
    renderCalendar();
  });
  
  document.getElementById('next-month').addEventListener('click', () => {
    currentDate.setMonth(currentDate.getMonth() + 1);
    renderCalendar();
  });
  
  // Initialize with first options selected
  if (equipmentButtons.length > 0) {
    equipmentButtons[0].click();
  }
  
  if (coolerButtons.length > 0) {
    coolerButtons[1].click(); // Default to "No" cooler
  }
  
  // Render initial calendar
  renderCalendar();
  
  // Functions
  
  // Render the calendar
  function renderCalendar() {
    if (!calendarEl) return;
    
    const year = currentDate.getFullYear();
    const month = currentDate.getMonth();
    
    // Set month header
    if (currentMonthEl) {
      currentMonthEl.textContent = new Date(year, month).toLocaleDateString(undefined, { 
        month: 'long', 
        year: 'numeric' 
      });
    }
    
    // Clear existing calendar
    calendarEl.innerHTML = '';
    
    // Add weekday headers
    const weekdays = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
    weekdays.forEach(day => {
      const dayEl = document.createElement('div');
      dayEl.className = 'weekday';
      dayEl.textContent = day;
      calendarEl.appendChild(dayEl);
    });
    
    // Calculate calendar days
    const firstDayOfMonth = new Date(year, month, 1);
    const daysFromPrevMonth = firstDayOfMonth.getDay(); // 0 (Sunday) to 6 (Saturday)
    const daysInMonth = new Date(year, month + 1, 0).getDate();
    const prevMonthLastDay = new Date(year, month, 0).getDate();
    
    // Add previous month's days
    for (let i = daysFromPrevMonth - 1; i >= 0; i--) {
      const dateEl = document.createElement('div');
      dateEl.className = 'date disabled';
      dateEl.textContent = prevMonthLastDay - i;
      calendarEl.appendChild(dateEl);
    }
    
    // Add current month's days
    for (let day = 1; day <= daysInMonth; day++) {
      const dateEl = document.createElement('div');
      dateEl.className = 'date';
      dateEl.textContent = day;
      
      const dateObj = new Date(year, month, day);
      
      // Check if date is today
      if (isToday(dateObj)) {
        dateEl.classList.add('today');
      }
      
      // Check if date is selected
      if (isDateSelected(dateObj)) {
        dateEl.classList.add('selected');
      }
      
      // Check if date is in selected range
      if (isInRange(dateObj)) {
        dateEl.classList.add('in-range');
      }
      
      // Disable past dates
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      
      if (dateObj < today) {
        dateEl.classList.add('disabled');
      } else {
        // Add click event to selectable dates
        dateEl.addEventListener('click', () => {
          selectDate(dateObj);
        });
      }
      
      calendarEl.appendChild(dateEl);
    }
    
    // Add next month's days to fill the grid
    const totalCells = calendarEl.childElementCount;
    const remainingCells = 7 - (totalCells % 7);
    
    if (remainingCells < 7) {
      for (let i = 1; i <= remainingCells; i++) {
        const dateEl = document.createElement('div');
        dateEl.className = 'date disabled';
        dateEl.textContent = i;
        calendarEl.appendChild(dateEl);
      }
    }
  }
  
  // Select a date
  function selectDate(date) {
    if (selectionMode === 'start') {
      // Start new selection
      selectedDates = [date];
      selectionMode = 'end';
      if (selectionStatusEl) {
        selectionStatusEl.textContent = 'Now select your end date';
      }
    } else {
      // Complete the selection
      selectedDates.push(date);
      
      // Sort dates to ensure start date comes first
      selectedDates.sort((a, b) => a - b);
      
      // Reset for next selection
      selectionMode = 'start';
      if (selectionStatusEl) {
        selectionStatusEl.textContent = 'Select your start date, then end date';
      }
    }
    
    // Update date display
    updateDateDisplay();
    
    // Update hidden inputs
    updateHiddenDateInputs();
    
    // Update price based on duration
    updateTotalPrice();
    
    // Re-render calendar to show selection
    renderCalendar();
  }
  
  // Check if date is today
  function isToday(date) {
    const today = new Date();
    return date.getDate() === today.getDate() && 
           date.getMonth() === today.getMonth() && 
           date.getFullYear() === today.getFullYear();
  }
  
  // Check if date is one of the selected dates
  function isDateSelected(date) {
    return selectedDates.some(selectedDate => 
      isSameDay(selectedDate, date)
    );
  }
  
  // Check if date is in the selected range
  function isInRange(date) {
    if (selectedDates.length !== 2) return false;
    
    const startDate = new Date(Math.min(
      selectedDates[0].getTime(),
      selectedDates[1].getTime()
    ));
    
    const endDate = new Date(Math.max(
      selectedDates[0].getTime(),
      selectedDates[1].getTime()
    ));
    
    return date >= startDate && date <= endDate;
  }
  
  // Compare if two dates are the same day
  function isSameDay(date1, date2) {
    return date1.getDate() === date2.getDate() && 
           date1.getMonth() === date2.getMonth() && 
           date1.getFullYear() === date2.getFullYear();
  }
  
  // Update the selected date range display
  function updateDateDisplay() {
    if (!selectedDateRangeEl) return;
    
    if (selectedDates.length === 0) {
      selectedDateRangeEl.textContent = '';
      return;
    }
    
    if (selectedDates.length === 1) {
      const formattedDate = formatDate(selectedDates[0]);
      selectedDateRangeEl.textContent = `Selected: ${formattedDate}`;
    } else {
      const startFormatted = formatDate(selectedDates[0]);
      const endFormatted = formatDate(selectedDates[1]);
      selectedDateRangeEl.textContent = `${startFormatted} to ${endFormatted}`;
    }
  }
  
  // Format date for display
  function formatDate(date) {
    return date.toLocaleDateString(undefined, {
      month: 'short',
      day: 'numeric',
      year: 'numeric'
    });
  }
  
  // Format date for Shopify (YYYY-MM-DD)
  function formatDateForShopify(date) {
    const year = date.getFullYear();
    const month = (date.getMonth() + 1).toString().padStart(2, '0');
    const day = date.getDate().toString().padStart(2, '0');
    return `${year}-${month}-${day}`;
  }
  
  // Update hidden date inputs
  function updateHiddenDateInputs() {
    if (selectedDates[0] && startDateInput) {
      startDateInput.value = formatDateForShopify(selectedDates[0]);
    }
    
    if (selectedDates[1] && endDateInput) {
      endDateInput.value = formatDateForShopify(selectedDates[1]);
    } else if (selectedDates[0] && endDateInput) {
      endDateInput.value = formatDateForShopify(selectedDates[0]);
    }
  }
  
  // Calculate duration between selected dates
  function calculateDuration() {
    if (selectedDates.length !== 2) return 1;
    
    const startDate = new Date(selectedDates[0]);
    const endDate = new Date(selectedDates[1]);
    
    // Set both to midnight for accurate day calculation
    startDate.setHours(0, 0, 0, 0);
    endDate.setHours(0, 0, 0, 0);
    
    // Calculate difference in days
    const diffTime = Math.abs(endDate - startDate);
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
    
    // Add 1 to include both start and end dates
    return diffDays + 1;
  }
  
  // Update base price based on equipment and cooler selection
  function updateBasePrice() {
    const equipmentPrice = basePrices[selectedEquipment] || 82.00; // Default to cheapest if not found
    const coolerAddition = coolerAdds[selectedCooler] || 0.00;
    
    const basePrice = equipmentPrice + coolerAddition;
    basePriceInput.value = basePrice.toFixed(2);
    
    // Update total price
    updateTotalPrice();
  }
  
  // Update total price based on duration and discount
  function updateTotalPrice() {
    const basePrice = parseFloat(basePriceInput.value);
    const duration = calculateDuration();
    
    // Get discount tier based on duration
    let discountMultiplier = 1.0;
    if (duration === 2) {
      discountMultiplier = 0.9; // 10% discount
    } else if (duration >= 3) {
      discountMultiplier = 0.8; // 20% discount
    }
    
    // Calculate total price
    const totalPrice = basePrice * duration * discountMultiplier;
    
    // Update hidden inputs
    durationInput.value = duration;
    discountInput.value = discountMultiplier;
    totalPriceInput.value = totalPrice.toFixed(2);
    
    // Format for display
    const formatter = new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: 'USD',
    });
    
    // Update price display
    if (displayedPriceEl) {
      displayedPriceEl.textContent = formatter.format(totalPrice);
    }
    
    // Update price breakdown
    if (priceBreakdownEl) {
      if (duration > 1) {
        let breakdownHtml = `<div>Duration: ${duration} days</div>`;
        
        if (discountMultiplier < 1) {
          const discount = Math.round((1 - discountMultiplier) * 100);
          breakdownHtml += `<div>Discount: ${discount}% off</div>`;
          breakdownHtml += `<div>Base Price: ${formatter.format(basePrice)} × ${duration} days</div>`;
        }
        
        priceBreakdownEl.innerHTML = breakdownHtml;
      } else {
        priceBreakdownEl.innerHTML = ''; // Clear breakdown for single day
      }
    }
    
    // Update the original Shopify price display if present
    updateShopifyPriceDisplay(totalPrice);
  }
  
  // Update Shopify's price display if present
  function updateShopifyPriceDisplay(price) {
    const formatter = new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: 'USD',
    });
    
    // Try to find and update Shopify's price elements
    const priceElements = document.querySelectorAll('.price__regular .price-item--regular, .price-item--regular');
    priceElements.forEach(el => {
      if (el && !el.closest('.booking-system-container')) { // Don't update our own price elements
        el.textContent = formatter.format(price);
      }
    });
  }
  
  // Update product image based on equipment and cooler selection
  function updateProductImage() {
    const imageKey = `${selectedEquipment}-${selectedCooler}`;
    const imageMapping = {
      "1U2C-Yes": "2C1UYes",
      "1U1C-Yes": "1C1UYes", 
      "2C-Yes": "2CYes",
      "1C-Yes": "1CYes",
      "1U-Yes": "1UYes",
      "None-Yes": "Yes",
      "1U2C-No": "2C1U",
      "1U1C-No": "1C1U",
      "2C-No": "2C",
      "1C-No": "1C",
      "1U-No": "1U",
      "None-No": "None"
    };
    
    const imageName = imageMapping[imageKey] || "None";
    
    // Method 1: Try to find the right thumbnail and update it using dataset
    const thumbnails = document.querySelectorAll('.product-single__thumbnail');
    for (let i = 0; i < thumbnails.length; i++) {
      const thumbnail = thumbnails[i];
      const thumbnailImg = thumbnail.querySelector('img');
      
      if (thumbnailImg && thumbnailImg.src && thumbnailImg.src.includes(imageName)) {
        // Try setting the thumbnail as active without clicking it
        thumbnails.forEach(t => t.classList.remove('active-thumb'));
        thumbnail.classList.add('active-thumb');
        
        // Also update the main image directly if possible
        const mainImg = document.querySelector('.product-featured-img, .product-single__image, .product__img');
        if (mainImg && thumbnailImg.dataset.src) {
          mainImg.src = thumbnailImg.dataset.src;
          if (thumbnailImg.dataset.srcset) {
            mainImg.srcset = thumbnailImg.dataset.srcset;
          }
          
          // Remove zoom-related attributes and classes
          mainImg.removeAttribute('data-zoom');
          mainImg.removeAttribute('data-zoom-image');
          mainImg.classList.remove('zoom-img');
          
          // Apply no-magnify class and style
          mainImg.classList.add('no-magnify');
          mainImg.style.cursor = 'default';
          
          // Fix container styles
          const imgContainer = mainImg.closest('.product__media, .product-single__photo-wrapper');
          if (imgContainer) {
            imgContainer.style.overflow = 'visible';
            imgContainer.classList.remove('zoom-container');
          }
          
          return; // Exit if we successfully updated
        }
      }
    }
    
    // Method 2: Try direct image swap
    const mainImage = document.querySelector('.product__media img, .product-featured-media, .product-single__image');
    const allImages = document.querySelectorAll('.product__media-list img, .product-single__thumbnails img');
    
    for (let img of allImages) {
      const imgUrl = img.getAttribute('src') || '';
      if (imgUrl.includes(imageName) && mainImage) {
        mainImage.src = imgUrl;
        
        // Remove zoom functionality
        mainImage.removeAttribute('data-zoom');
        mainImage.removeAttribute('data-image-zoom');
        mainImage.classList.remove('zoom-img');
        
        // Ensure the image is displayed normally
        mainImage.style.maxWidth = '100%';
        mainImage.style.height = 'auto';
        mainImage.style.cursor = 'default';
        
        // Also fix parent container if needed
        const imgContainer = mainImage.closest('.product__media, .product-single__photo-wrapper');
        if (imgContainer) {
          imgContainer.style.overflow = 'visible';
          imgContainer.classList.remove('zoom-container');
        }
        
        // Remove any active zoom/lightbox
        const zoomOverlay = document.querySelector('.zoomContainer, .pswp--open, .zoom-overlay');
        if (zoomOverlay) {
          zoomOverlay.remove();
        }
        
        return; // Exit if we successfully updated
      }
    }
    
    // Method 3: Last resort - look for all image-related elements
    document.querySelectorAll('img').forEach(img => {
      const src = img.getAttribute('src') || '';
      if (src.includes(imageName) && !img.closest('.product-form') && !img.closest('.product__media-list')) {
        // This might be the main product image
        // Disable zoom and magnification
        img.setAttribute('data-image-magnify', 'none');
        img.classList.add('no-magnify');
        img.style.cursor = 'default';
        
        // Ensure any parent containers are properly styled
        const parent = img.parentElement;
        if (parent) {
          parent.style.overflow = 'visible';
        }
      }
    });
    
    // Cleanup any zoom containers
    setTimeout(() => {
      document.querySelectorAll('.zoomContainer, .pswp--open').forEach(el => el.remove());
    }, 100);
  }
});
</script>