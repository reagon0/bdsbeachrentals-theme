    // Modifications for the DateTimePicker class in booking-form-inputs.liquid

class DateTimePicker {
    constructor(settings = {}) {
        this.settings = {
            availability: {
                Monday: { start: '08:00', end: '22:00' },
                Tuesday: { start: '08:00', end: '22:00' },
                Wednesday: { start: '08:00', end: '22:00' },
                Thursday: { start: '08:00', end: '22:00' },
                Friday: { start: '08:00', end: '22:00' },
                Saturday: { start: '08:00', end: '22:00' },
                Sunday: { start: '08:00', end: '22:00' }
            },
            minTimeFromNow: 60, // 1 hour minimum by default
            timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
            timeFormat: '12',
            minuteStep: 30,
            startFromNow: true,
            // Add discount tiers for multi-day pricing
            discountTiers: {
                1: 1.00, // 100% of price (no discount)
                2: 0.80, // 80% per day (20% discount)
                3: 0.70  // 70% per day (30% discount) for 3+ days
            },
            ...settings
        };

        this.currentDate = new Date();
        this.minDateTime = new Date();
        this.minDateTime.setMinutes(this.minDateTime.getMinutes() + this.settings.minTimeFromNow)

        // Preselect the first available date 
        this.selectedDate = new Date(
            this.minDateTime.getFullYear(),
            this.minDateTime.getMonth(),
            this.minDateTime.getDate()
        );

        // Initialize array for multi-day selection
        this.selectedDates = [this.selectedDate];
        this.selectionMode = 'start'; // 'start' or 'end' mode for range selection

        this.initializeElements();
        this.setupEventListeners();
        this.render();

        // After rendering, select the first available time
        this.preselectFirstAvailableTime();
    }

    initializeElements() {
        this.calendarEl = document.getElementById('calendar');
        this.currentMonthEl = document.getElementById('current-month');
        this.timeSelectEl = document.getElementById('time-select');
        this.selectedDateTimeEl = document.getElementById('selected-datetime');
        this.shopifyDateInput = document.getElementById('shopify-date-input');
        this.shopifyTimeInput = document.getElementById('shopify-time-input');
        
        // Add new elements for multi-day selection
        this.shopifyEndDateInput = document.getElementById('shopify-end-date-input');
        this.shopifyDurationInput = document.getElementById('shopify-duration-input');
        this.shopifyDiscountInput = document.getElementById('shopify-discount-input');
        
        // Get base price from product variant
        this.basePrice = this.getBasePrice();
        this.totalPriceEl = document.getElementById('booking-total-price');
    }

    getBasePrice() {
        // Get the price from the current product variant
        const priceElement = document.querySelector('.price .price__regular .price-item--regular');
        if (priceElement) {
            const priceText = priceElement.textContent.trim();
            // Extract just the number from the price text (remove currency symbols, etc.)
            const priceMatch = priceText.match(/[\d,.]+/);
            if (priceMatch) {
                return parseFloat(priceMatch[0].replace(/,/g, ''));
            }
        }
        return 0; // Default if price can't be found
    }

    setupEventListeners() {
        document.getElementById('prev-month').addEventListener('click', () => {
            this.currentDate.setMonth(this.currentDate.getMonth() - 1);
            this.render();
        });

        document.getElementById('next-month').addEventListener('click', () => {
            this.currentDate.setMonth(this.currentDate.getMonth() + 1);
            this.render();
        });

        this.timeSelectEl.addEventListener('change', (e) => {
            this.selectTime(e.target.value);
        });
        
        // Add event listener for switching selection mode
        document.getElementById('booking-mode-toggle').addEventListener('click', () => {
            this.toggleSelectionMode();
        });
        
        // Add event listener for product variant changes to update base price
        document.addEventListener('variant:change', () => {
            this.basePrice = this.getBasePrice();
            this.updateTotalPrice();
        });
    }

    toggleSelectionMode() {
        if (this.selectionMode === 'start') {
            this.selectionMode = 'end';
            document.getElementById('booking-mode-toggle').textContent = 'Select Start Date';
        } else {
            this.selectionMode = 'start';
            document.getElementById('booking-mode-toggle').textContent = 'Select End Date';
        }
    }

    render() {
        this.renderCalendar();
        this.renderTimeDropdown();
        this.updateSelectedDateTime();
        this.updateTotalPrice();
    }

    renderCalendar() {
        const year = this.currentDate.getFullYear();
        const month = this.currentDate.getMonth();

        this.currentMonthEl.textContent = new Date(year, month)
            .toLocaleDateString(undefined, { month: 'long', year: 'numeric' });

        this.calendarEl.innerHTML = '';

        // Add weekday headers
        const weekdays = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
        weekdays.forEach(day => {
            const dayEl = document.createElement('div');
            dayEl.className = 'weekday';
            dayEl.textContent = day;
            this.calendarEl.appendChild(dayEl);
        });

        const firstDayOfMonth = new Date(year, month, 1);
        const daysFromPrevMonth = firstDayOfMonth.getDay();
        const daysInMonth = new Date(year, month + 1, 0).getDate();
        const prevMonthLastDay = new Date(year, month, 0).getDate();

        // Add previous month's days
        for (let i = daysFromPrevMonth - 1; i >= 0; i--) {
            const dateEl = document.createElement('div');
            dateEl.className = 'date disabled';
            dateEl.textContent = prevMonthLastDay - i;
            this.calendarEl.appendChild(dateEl);
        }

        // Current month days
        for (let day = 1; day <= daysInMonth; day++) {
            const dateEl = document.createElement('div');
            dateEl.className = 'date';
            dateEl.textContent = day;

            const currentDate = new Date(year, month, day);
            
            // Check if date is in the selected range
            const isInRange = this.isDateInSelectedRange(currentDate);
            if (isInRange) {
                dateEl.classList.add('in-range');
            }

            // Check if date is selected (start or end date)
            if (this.isDateSelected(currentDate)) {
                dateEl.classList.add('selected');
            }

            if (currentDate.toDateString() === new Date().toDateString()) {
                dateEl.classList.add('today');
            }

            const currentDateMidnight = new Date(currentDate.getFullYear(), currentDate.getMonth(), currentDate.getDate());
            const minDateMidnight = new Date(this.minDateTime.getFullYear(), this.minDateTime.getMonth(), this.minDateTime.getDate());

            if (currentDateMidnight < minDateMidnight) {
                dateEl.classList.add('disabled');
            } else {
                dateEl.addEventListener('click', () => {
                    this.selectDate(new Date(year, month, day));
                });
            }

            this.calendarEl.appendChild(dateEl);
        }

        // Add next month's days to complete the grid
        const totalDaysOnCalendar = this.calendarEl.children.length;
        const nextMonthDays = Math.ceil(totalDaysOnCalendar / 7) * 7 - totalDaysOnCalendar;

        for (let i = 1; i <= nextMonthDays; i++) {
            const dateEl = document.createElement('div');
            dateEl.className = 'date disabled';
            dateEl.textContent = i;
            this.calendarEl.appendChild(dateEl);
        }
    }

    isDateSelected(date) {
        return this.selectedDates.some(selectedDate => 
            selectedDate.toDateString() === date.toDateString());
    }

    isDateInSelectedRange(date) {
        if (this.selectedDates.length !== 2) return false;
        
        const startDate = new Date(Math.min(
            this.selectedDates[0].getTime(), 
            this.selectedDates[1].getTime()
        ));
        const endDate = new Date(Math.max(
            this.selectedDates[0].getTime(), 
            this.selectedDates[1].getTime()
        ));
        
        return date >= startDate && date <= endDate;
    }

    selectDate(date) {
        if (this.selectionMode === 'start') {
            // Clear previous selection if we're starting a new range
            this.selectedDates = [date];
            this.selectionMode = 'end';
            document.getElementById('booking-mode-toggle').textContent = 'Select Start Date';
        } else {
            // Add end date to complete the range
            this.selectedDates.push(date);
            // Sort dates to ensure start date is first
            this.selectedDates.sort((a, b) => a - b);
            this.selectionMode = 'start';
            document.getElementById('booking-mode-toggle').textContent = 'Select End Date';
        }
        
        this.updateShopifyInputs();
        this.render();
    }

    // Calculate the number of days in the booking
    calculateDuration() {
        if (this.selectedDates.length !== 2) return 1;
        
        const startDate = new Date(this.selectedDates[0]);
        const endDate = new Date(this.selectedDates[1]);
        
        // Set time to midnight to ensure we're only counting days
        startDate.setHours(0, 0, 0, 0);
        endDate.setHours(0, 0, 0, 0);
        
        // Calculate difference in days
        const diffTime = Math.abs(endDate - startDate);
        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
        
        // Add 1 to include both start and end dates
        return diffDays + 1;
    }

    // Get the discount multiplier based on duration
    getDiscountMultiplier(duration) {
        // Use the highest applicable discount tier
        for (let tier = Math.min(duration, 3); tier > 0; tier--) {
            if (this.settings.discountTiers[tier]) {
                return this.settings.discountTiers[tier];
            }
        }
        return 1; // Default: no discount
    }

    // Calculate total price based on duration and discount
    calculateTotalPrice() {
        const duration = this.calculateDuration();
        const discountMultiplier = this.getDiscountMultiplier(duration);
        return this.basePrice * duration * discountMultiplier;
    }

    // Update the displayed total price
    updateTotalPrice() {
        if (!this.totalPriceEl) return;
        
        const duration = this.calculateDuration();
        const discountMultiplier = this.getDiscountMultiplier(duration);
        const totalPrice = this.calculateTotalPrice();
        
        // Format the price
        const formatter = new Intl.NumberFormat('en-US', {
            style: 'currency',
            currency: 'USD',
        });
        
        // Update the display
        let priceHtml = `<div class="booking-price-summary">`;
        priceHtml += `<div>Duration: ${duration} day${duration !== 1 ? 's' : ''}</div>`;
        
        if (discountMultiplier < 1) {
            const discount = (1 - discountMultiplier) * 100;
            priceHtml += `<div>Discount: ${discount}% off</div>`;
            priceHtml += `<div>Base Price: ${formatter.format(this.basePrice)} × ${duration} days</div>`;
        }
        
        priceHtml += `<div class="booking-total">Total: ${formatter.format(totalPrice)}</div>`;
        priceHtml += `</div>`;
        
        this.totalPriceEl.innerHTML = priceHtml;
        
        // Update hidden inputs
        if (this.shopifyDurationInput) {
            this.shopifyDurationInput.value = duration;
        }
        
        if (this.shopifyDiscountInput) {
            this.shopifyDiscountInput.value = discountMultiplier;
        }
    }

    selectTime(time) {
        this.selectedTime = time;
        this.updateShopifyInputs();
        this.updateSelectedDateTime();
    }

    updateShopifyInputs() {
        // Update start date
        if (this.selectedDates[0] && this.shopifyDateInput) {
            this.shopifyDateInput.value = this.formatDateForShopify(this.selectedDates[0]);
        }
        
        // Update end date
        if (this.selectedDates[1] && this.shopifyEndDateInput) {
            this.shopifyEndDateInput.value = this.formatDateForShopify(this.selectedDates[1]);
        } else if (this.shopifyEndDateInput) {
            // If no end date yet, use the start date
            this.shopifyEndDateInput.value = this.shopifyDateInput.value;
        }
        
        // Update time
        if (this.selectedTime && this.shopifyTimeInput) {
            this.shopifyTimeInput.value = this.formatTimeForShopify(this.selectedTime);
        }
        
        // Update duration and price
        this.updateTotalPrice();
    }

    updateSelectedDateTime() {
        if (this.selectedDates.length > 0 && this.selectedTime) {
            let displayText = '';
            
            if (this.selectedDates.length === 1) {
                // Single date
                const formattedDate = this.selectedDates[0].toLocaleDateString(undefined, {
                    weekday: 'long',
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                });
                displayText = `${formattedDate} at ${this.formatTimeForDisplay(this.selectedTime)}`;
            } else {
                // Date range
                const startDate = this.selectedDates[0].toLocaleDateString(undefined, {
                    weekday: 'long',
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                });
                
                const endDate = this.selectedDates[1].toLocaleDateString(undefined, {
                    weekday: 'long',
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                });
                
                displayText = `From ${startDate} to ${endDate}`;
                displayText += `<br>Pickup: ${this.formatTimeForDisplay(this.selectedTime)}`;
            }
            
            this.selectedDateTimeEl.innerHTML = displayText;
        } else {
            this.selectedDateTimeEl.textContent = 'Select dates';
        }
    }

    // Rest of the methods remain the same...
}

    {% liquid
        assign days_in_a_week = 'monday-tuesday-wednesday-thursday-friday-saturday-sunday' | split: '-'
        assign availability_options = ''
        assign template = "[day]: { start: '[start_time]', end: '[end_time]' }"
        for day_in_a_week in days_in_a_week
            assign block_key = 'dt_' | append: day_in_a_week
            assign row_results = template
            assign capitalize_day_in_a_week = day_in_a_week | capitalize
            assign row_results = row_results | replace: '[day]', capitalize_day_in_a_week

            assign start_time = block.settings[block_key] | split: '-' | first

            assign time_parts = start_time | split: ":"
            assign hour = time_parts[0] | times: 1
            assign minutes = time_parts[1] | slice: 0, 2
            assign ampm = time_parts[1] | slice: -2, 2 | downcase
            if ampm == "pm" and hour != 12
                assign hour = hour | plus: 12
            endif
            if ampm == "am" and hour == 12
                assign hour = 0
            endif

            assign prepared_time = hour | append: ":" | append: minutes
            assign row_results = row_results | replace: '[start_time]', prepared_time

            assign end_time = block.settings[block_key] | split: '-' | last

            assign time_parts = end_time | split: ":"
            assign hour = time_parts[0] | times: 1
            assign minutes = time_parts[1] | slice: 0, 2
            assign ampm = time_parts[1] | slice: -2, 2 | downcase
            if ampm == "pm" and hour != 12
                assign hour = hour | plus: 12
            endif
            if ampm == "am" and hour == 12
                assign hour = 0
            endif

            assign prepared_time = hour | append: ":" | append: minutes
            assign row_results = row_results | replace: '[end_time]', prepared_time

            assign availability_options = availability_options | append: row_results
            unless forloop.last
                assign availability_options = availability_options | append: ","
            endunless
        endfor
    %}

    // Initialize with settings
    const picker = new DateTimePicker({
        availability: {
            {{ availability_options }}
        },
        minTimeFromNow: 60, // 1 hour minimum
        timeFormat: '12',
        minuteStep: 30,
        startFromNow: true
    });
</script>