    // Modifications for the DateTimePicker class in booking-form-inputs.liquid

<script>
class DateTimePicker {
    constructor(settings = {}) {
        this.settings = {
            availability: {
                Monday: { start: '08:00', end: '22:00' },
                Tuesday: { start: '08:00', end: '22:00' },
                Wednesday: { start: '08:00', end: '22:00' },
                Thursday: { start: '08:00', end: '22:00' },
                Friday: { start: '08:00', end: '22:00' },
                Saturday: { start: '08:00', end: '22:00' },
                Sunday: { start: '08:00', end: '22:00' }
            },
            minTimeFromNow: 60, // 1 hour minimum by default
            timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
            timeFormat: '12',
            minuteStep: 30,
            startFromNow: true,
            // Discount tiers for multi-day pricing
            discountTiers: {
                1: 1.00, // 100% of price (no discount)
                2: 0.80, // 80% per day (20% discount)
                3: 0.70  // 70% per day (30% discount) for 3+ days
            },
            ...settings
        };

        this.currentDate = new Date();
        this.minDateTime = new Date();
        this.minDateTime.setMinutes(this.minDateTime.getMinutes() + this.settings.minTimeFromNow);

        // Initialize date selection variables
        this.startDate = null;
        this.endDate = null;
        this.selectedTime = null;
        this.selectionState = 'start'; // 'start' or 'end'

        this.initializeElements();
        this.setupEventListeners();
        this.render();
        this.updateSelectionStatus();
        
        // Preselect first available time
        this.preselectFirstAvailableTime();
    }

    initializeElements() {
        this.calendarEl = document.getElementById('calendar');
        this.currentMonthEl = document.getElementById('current-month');
        this.timeSelectEl = document.getElementById('time-select');
        this.selectedDateRangeEl = document.getElementById('selected-date-range');
        this.selectionStatusEl = document.getElementById('selection-status');
        
        // Hidden inputs for Shopify
        this.shopifyDateInput = document.getElementById('shopify-date-input');
        this.shopifyEndDateInput = document.getElementById('shopify-end-date-input');
        this.shopifyTimeInput = document.getElementById('shopify-time-input');
        this.shopifyDurationInput = document.getElementById('shopify-duration-input');
        this.shopifyDiscountInput = document.getElementById('shopify-discount-input');
        
        // Price elements
        this.basePrice = this.getBasePrice();
        this.totalPriceEl = document.getElementById('booking-total-price');
    }

    preselectFirstAvailableTime() {
        if (this.timeSelectEl && this.timeSelectEl.options.length > 0) {
            const firstTimeOption = this.timeSelectEl.options[0].value;
            this.selectTime(firstTimeOption);
        }
    }

    getBasePrice() {
        // Get the price from the current product variant
        const priceElement = document.querySelector('.price .price__regular .price-item--regular');
        if (priceElement) {
            const priceText = priceElement.textContent.trim();
            // Extract number from price text
            const priceMatch = priceText.match(/[\d,.]+/);
            if (priceMatch) {
                return parseFloat(priceMatch[0].replace(/,/g, ''));
            }
        }
        return 0; // Default if price can't be found
    }

    setupEventListeners() {
        document.getElementById('prev-month').addEventListener('click', () => {
            this.currentDate.setMonth(this.currentDate.getMonth() - 1);
            this.render();
        });

        document.getElementById('next-month').addEventListener('click', () => {
            this.currentDate.setMonth(this.currentDate.getMonth() + 1);
            this.render();
        });

        this.timeSelectEl.addEventListener('change', (e) => {
            this.selectTime(e.target.value);
        });
        
        // Listen for product variant changes to update the price
        document.addEventListener('variant:change', () => {
            this.basePrice = this.getBasePrice();
            this.updateTotalPrice();
        });
    }

    updateSelectionStatus() {
        if (!this.selectionStatusEl) return;
        
        if (this.selectionState === 'start') {
            this.selectionStatusEl.textContent = 'Select Start Date';
        } else {
            this.selectionStatusEl.textContent = 'Select End Date';
        }
    }

    render() {
        this.renderCalendar();
        this.renderTimeDropdown();
        this.updateSelectedDateRange();
        this.updateTotalPrice();
    }

    renderCalendar() {
        const year = this.currentDate.getFullYear();
        const month = this.currentDate.getMonth();

        this.currentMonthEl.textContent = new Date(year, month)
            .toLocaleDateString(undefined, { month: 'long', year: 'numeric' });

        this.calendarEl.innerHTML = '';

        // Add weekday headers
        const weekdays = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
        weekdays.forEach(day => {
            const dayEl = document.createElement('div');
            dayEl.className = 'weekday';
            dayEl.textContent = day;
            this.calendarEl.appendChild(dayEl);
        });

        const firstDayOfMonth = new Date(year, month, 1);
        const daysFromPrevMonth = firstDayOfMonth.getDay();
        const daysInMonth = new Date(year, month + 1, 0).getDate();
        const prevMonthLastDay = new Date(year, month, 0).getDate();

        // Add previous month's days
        for (let i = daysFromPrevMonth - 1; i >= 0; i--) {
            const dateEl = document.createElement('div');
            dateEl.className = 'date disabled';
            dateEl.textContent = prevMonthLastDay - i;
            this.calendarEl.appendChild(dateEl);
        }

        // Current month days
        for (let day = 1; day <= daysInMonth; day++) {
            const dateEl = document.createElement('div');
            dateEl.className = 'date';
            dateEl.textContent = day;

            const currentDate = new Date(year, month, day);
            
            // Check if this date is the start date
            if (this.startDate && this.isSameDay(currentDate, this.startDate)) {
                dateEl.classList.add('start-date');
            }
            
            // Check if this date is the end date
            if (this.endDate && this.isSameDay(currentDate, this.endDate)) {
                dateEl.classList.add('end-date');
            }
            
            // Check if date is in the selected range
            if (this.isDateInRange(currentDate)) {
                dateEl.classList.add('in-range');
            }

            if (this.isSameDay(currentDate, new Date())) {
                dateEl.classList.add('today');
            }

            const currentDateMidnight = new Date(currentDate);
            currentDateMidnight.setHours(0, 0, 0, 0);
            
            const minDateMidnight = new Date(this.minDateTime);
            minDateMidnight.setHours(0, 0, 0, 0);

            if (currentDateMidnight < minDateMidnight) {
                dateEl.classList.add('disabled');
            } else {
                dateEl.addEventListener('click', () => {
                    this.handleDateClick(new Date(year, month, day));
                });
            }

            this.calendarEl.appendChild(dateEl);
        }

        // Add next month's days to complete the grid
        const totalDaysOnCalendar = this.calendarEl.children.length;
        const nextMonthDays = Math.ceil(totalDaysOnCalendar / 7) * 7 - totalDaysOnCalendar;

        for (let i = 1; i <= nextMonthDays; i++) {
            const dateEl = document.createElement('div');
            dateEl.className = 'date disabled';
            dateEl.textContent = i;
            this.calendarEl.appendChild(dateEl);
        }
    }

    isSameDay(date1, date2) {
        return date1.getDate() === date2.getDate() && 
               date1.getMonth() === date2.getMonth() && 
               date1.getFullYear() === date2.getFullYear();
    }

    isDateInRange(date) {
        if (!this.startDate || !this.endDate) return false;
        
        // Ensure correct order of dates
        const start = new Date(Math.min(this.startDate.getTime(), this.endDate.getTime()));
        const end = new Date(Math.max(this.startDate.getTime(), this.endDate.getTime()));
        
        // Set all to midnight for proper date comparison
        start.setHours(0, 0, 0, 0);
        end.setHours(0, 0, 0, 0);
        const checkDate = new Date(date);
        checkDate.setHours(0, 0, 0, 0);
        
        // Check if the date is between start and end (exclusive)
        return checkDate > start && checkDate < end;
    }

    handleDateClick(date) {
        if (this.selectionState === 'start') {
            // Start new selection
            this.startDate = date;
            this.endDate = null;
            this.selectionState = 'end';
        } else {
            // Complete the range
            // If clicked date is before start date, swap them
            if (date < this.startDate) {
                this.endDate = this.startDate;
                this.startDate = date;
            } else {
                this.endDate = date;
            }
            this.selectionState = 'start';
        }
        
        this.updateShopifyInputs();
        this.updateSelectionStatus();
        this.render();
    }

    renderTimeDropdown() {
        if (!this.timeSelectEl) return;
        
        this.timeSelectEl.innerHTML = '';
        
        // Only show time dropdown if start date is selected
        if (!this.startDate) {
            this.timeSelectEl.disabled = true;
            return;
        }
        
        this.timeSelectEl.disabled = false;
        
        const dayOfWeek = this.startDate.toLocaleString('en-US', { weekday: 'long' });
        const dayAvailability = this.settings.availability[dayOfWeek];

        if (!dayAvailability) return;

        const [startHour] = dayAvailability.start.split(':').map(Number);
        const [endHour] = dayAvailability.end.split(':').map(Number);

        const isSelectedDateToday = this.isSameDay(this.startDate, new Date());

        for (let hour = startHour; hour <= endHour; hour++) {
            for (let minute = 0; minute < 60; minute += this.settings.minuteStep) {
                if (hour === endHour && minute > 0) continue;
                
                const timeString = `${hour.toString().padStart(2, '0')}:${minute.toString().padStart(2, '0')}`;

                if (isSelectedDateToday) {
                    const timeDate = new Date(this.startDate);
                    timeDate.setHours(hour, minute);
                    if (timeDate < this.minDateTime) continue;
                }

                const option = document.createElement('option');
                option.value = timeString;
                option.textContent = this.formatTimeForDisplay(timeString);
                
                if (this.selectedTime === timeString) {
                    option.selected = true;
                }
                
                this.timeSelectEl.appendChild(option);
            }
        }
    }

    formatTimeForDisplay(time) {
        if (!time) return '';
        
        const [hours, minutes] = time.split(':');
        const hour = parseInt(hours, 10);
        const ampm = hour >= 12 ? 'PM' : 'AM';
        const hour12 = hour % 12 || 12;
        
        return `${hour12}:${minutes} ${ampm}`;
    }

    formatDateForShopify(date) {
        if (!date) return '';
        
        const month = (date.getMonth() + 1).toString().padStart(2, '0');
        const day = date.getDate().toString().padStart(2, '0');
        const year = date.getFullYear();
        
        return `${month}/${day}/${year}`;
    }

    formatTimeForShopify(time) {
        if (!time) return '';
        
        const [hours, minutes] = time.split(':');
        const hour = parseInt(hours, 10);
        const ampm = hour >= 12 ? 'pm' : 'am';
        const hour12 = (hour % 12 || 12).toString().padStart(2, '0');
        
        return `${hour12}:${minutes}${ampm}`;
    }

    selectTime(time) {
        this.selectedTime = time;
        this.updateShopifyInputs();
        this.updateSelectedDateRange();
    }

    // Calculate the number of days in the booking
    calculateDuration() {
        if (!this.startDate || !this.endDate) return 1;
        
        const start = new Date(this.startDate);
        const end = new Date(this.endDate);
        
        // Set time to midnight for proper day calculation
        start.setHours(0, 0, 0, 0);
        end.setHours(0, 0, 0, 0);
        
        // Calculate difference in days
        const diffTime = Math.abs(end - start);
        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
        
        // Add 1 to include both start and end dates
        return diffDays + 1;
    }

    // Get the discount multiplier based on duration
    getDiscountMultiplier(duration) {
        // Use the highest applicable discount tier
        for (let tier = Math.min(duration, 3); tier > 0; tier--) {
            if (this.settings.discountTiers[tier]) {
                return this.settings.discountTiers[tier];
            }
        }
        return 1; // Default: no discount
    }

    // Calculate total price based on duration and discount
    calculateTotalPrice() {
        const duration = this.calculateDuration();
        const discountMultiplier = this.getDiscountMultiplier(duration);
        return this.basePrice * duration * discountMultiplier;
    }

    updateShopifyInputs() {
        // Update start date
        if (this.startDate && this.shopifyDateInput) {
            this.shopifyDateInput.value = this.formatDateForShopify(this.startDate);
        }
        
        // Update end date
        if (this.endDate && this.shopifyEndDateInput) {
            this.shopifyEndDateInput.value = this.formatDateForShopify(this.endDate);
        } else if (this.shopifyEndDateInput && this.startDate) {
            // If no end date yet, use the start date
            this.shopifyEndDateInput.value = this.formatDateForShopify(this.startDate);
        }
        
        // Update time
        if (this.selectedTime && this.shopifyTimeInput) {
            this.shopifyTimeInput.value = this.formatTimeForShopify(this.selectedTime);
        }
        
        // Update duration and discount info
        const duration = this.calculateDuration();
        if (this.shopifyDurationInput) {
            this.shopifyDurationInput.value = duration;
        }
        
        const discountMultiplier = this.getDiscountMultiplier(duration);
        if (this.shopifyDiscountInput) {
            this.shopifyDiscountInput.value = discountMultiplier;
        }
    }

    updateSelectedDateRange() {
        if (!this.selectedDateRangeEl) return;
        
        if (!this.startDate) {
            this.selectedDateRangeEl.textContent = 'Select your booking dates';
            return;
        }
        
        const formatDate = (date) => {
            return date.toLocaleDateString(undefined, {
                weekday: 'short',
                month: 'short',
                day: 'numeric'
            });
        };
        
        let displayText = '';
        
        if (this.startDate && !this.endDate) {
            // Only start date selected
            displayText = `Start: ${formatDate(this.startDate)}`;
            if (this.selectedTime) {
                displayText += ` at ${this.formatTimeForDisplay(this.selectedTime)}`;
            }
        } else if (this.startDate && this.endDate) {
            // Both dates selected
            const duration = this.calculateDuration();
            
            displayText = `${formatDate(this.startDate)} to ${formatDate(this.endDate)}`;
            displayText += ` (${duration} day${duration !== 1 ? 's' : ''})`;
            
            if (this.selectedTime) {
                displayText += `<br>Pickup: ${this.formatTimeForDisplay(this.selectedTime)}`;
            }
        }
        
        this.selectedDateRangeEl.innerHTML = displayText;
    }

    updateTotalPrice() {
        if (!this.totalPriceEl || !this.startDate) return;
        
        const duration = this.calculateDuration();
        const discountMultiplier = this.getDiscountMultiplier(duration);
        const totalPrice = this.calculateTotalPrice();
        
        // Format the price
        const formatter = new Intl.NumberFormat('en-US', {
            style: 'currency',
            currency: 'USD',
        });
        
        // Update the display
        let priceHtml = `<div class="booking-price-summary">`;
        priceHtml += `<div>Duration: ${duration} day${duration !== 1 ? 's' : ''}</div>`;
        
        if (discountMultiplier < 1) {
            const discount = (1 - discountMultiplier) * 100;
            priceHtml += `<div>Discount: ${discount}% off</div>`;
            priceHtml += `<div>Base Price: ${formatter.format(this.basePrice)} × ${duration} days</div>`;
        }
        
        priceHtml += `<div class="booking-total">Total: ${formatter.format(totalPrice)}</div>`;
        priceHtml += `</div>`;
        
        this.totalPriceEl.innerHTML = priceHtml;
    }
}

// Initialize with settings
{% liquid
    assign days_in_a_week = 'monday-tuesday-wednesday-thursday-friday-saturday-sunday' | split: '-'
    assign availability_options = ''
    assign template = "[day]: { start: '[start_time]', end: '[end_time]' }"
    for day_in_a_week in days_in_a_week
        assign block_key = 'dt_' | append: day_in_a_week
        assign row_results = template
        assign capitalize_day_in_a_week = day_in_a_week | capitalize
        assign row_results = row_results | replace: '[day]', capitalize_day_in_a_week

        assign start_time = block.settings[block_key] | split: '-' | first

        assign time_parts = start_time | split: ":"
        assign hour = time_parts[0] | times: 1
        assign minutes = time_parts[1] | slice: 0, 2
        assign ampm = time_parts[1] | slice: -2, 2 | downcase
        if ampm == "pm" and hour != 12
            assign hour = hour | plus: 12
        endif
        if ampm == "am" and hour == 12
            assign hour = 0
        endif

        assign prepared_time = hour | append: ":" | append: minutes
        assign row_results = row_results | replace: '[start_time]', prepared_time

        assign end_time = block.settings[block_key] | split: '-' | last

        assign time_parts = end_time | split: ":"
        assign hour = time_parts[0] | times: 1
        assign minutes = time_parts[1] | slice: 0, 2
        assign ampm = time_parts[1] | slice: -2, 2 | downcase
        if ampm == "pm" and hour != 12
            assign hour = hour | plus: 12
        endif
        if ampm == "am" and hour == 12
            assign hour = 0
        endif

        assign prepared_time = hour | append: ":" | append: minutes
        assign row_results = row_results | replace: '[end_time]', prepared_time

        assign availability_options = availability_options | append: row_results
        unless forloop.last
            assign availability_options = availability_options | append: ","
        endunless
    endfor
%}

const picker = new DateTimePicker({
    availability: {
        {{ availability_options }}
    },
    minTimeFromNow: 60, // 1 hour minimum
    timeFormat: '12',
    minuteStep: 30,
    startFromNow: true
});
