<!-- Beach Cart Booking System with Line Item Properties -->
<div class="booking-system-container">
  <!-- Equipment Selection -->
  <fieldset class="product-form__input">
    <legend class="form__label">Equipment</legend>
    <div class="equipment-options">
      <button type="button" class="option-button" data-equipment="1U2C" data-image-key="2C1UYes" data-price="110.00">1x Umbrella 2x Chair</button>
      <button type="button" class="option-button" data-equipment="1U1C" data-image-key="1C1UYes" data-price="96.00">1x Umbrella 1x Chair</button>
      <button type="button" class="option-button" data-equipment="2C" data-image-key="2C" data-price="96.00">2x Chair</button>
      <button type="button" class="option-button" data-equipment="1C" data-image-key="1C" data-price="89.00">1x Chair</button>
      <button type="button" class="option-button" data-equipment="1U" data-image-key="1U" data-price="89.00">1x Umbrella</button>
      <button type="button" class="option-button" data-equipment="None" data-image-key="None" data-price="82.00">Just the cart</button>
    </div>
  </fieldset>

  <!-- Cooler Option -->
  <fieldset class="product-form__input">
    <legend class="form__label">Include 25qt Cooler</legend>
    <div class="cooler-options">
      <button type="button" class="option-button cooler-button" data-cooler="Yes" data-price-add="7.00">Yes</button>
      <button type="button" class="option-button cooler-button" data-cooler="No" data-price-add="0.00">No</button>
    </div>
  </fieldset>

  <!-- Booking Dates -->
  <fieldset class="product-form__input">
    <legend class="form__label">Booking Dates</legend>
    <div class="datetime-picker">
      <div class="calendar-header">
        <button id="prev-month" type="button"><svg class="icon icon-caret" viewBox="0 0 10 6"><path fill="currentColor" fill-rule="evenodd" d="M9.354.646a.5.5 0 0 0-.708 0L5 4.293 1.354.646a.5.5 0 0 0-.708.708l4 4a.5.5 0 0 0 .708 0l4-4a.5.5 0 0 0 0-.708" clip-rule="evenodd"></path></svg></button>
        <span id="current-month"></span>
        <button id="next-month" type="button"><svg class="icon icon-caret" viewBox="0 0 10 6"><path fill="currentColor" fill-rule="evenodd" d="M9.354.646a.5.5 0 0 0-.708 0L5 4.293 1.354.646a.5.5 0 0 0-.708.708l4 4a.5.5 0 0 0 .708 0l4-4a.5.5 0 0 0 0-.708" clip-rule="evenodd"></path></svg></button>
      </div>
      
      <div class="selection-status" id="selection-status">
        Select your start date, then end date
      </div>
      
      <div class="calendar-grid" id="calendar">
        <!-- Calendar will be generated here -->
      </div>
      
      <div class="selected-date-range" id="selected-date-range"></div>
    </div>
  </fieldset>

  <!-- Pickup/Dropoff Locations -->
  <fieldset class="product-form__input">
    <legend class="form__label">Preferred Pickup Location</legend>
    <input type="text" id="preferred_pickup_location" class="input-field" name="properties[Preferred Pickup Location]" placeholder="Include full address"/>
  </fieldset>

  <fieldset class="product-form__input">
    <legend class="form__label">Preferred Drop-off Location</legend>
    <input type="text" id="preferred_drop_off_location" class="input-field" name="properties[Preferred Drop-off Location]" placeholder="Include full address">
  </fieldset>

  <fieldset class="product-form__input">
    <legend class="form__label">Additional Rental Details</legend>
    <textarea id="special_requirements" class="input-field" name="properties[Special Requests]" placeholder="Let us know how we can help"></textarea>
  </fieldset>

  <!-- Price Display -->
  <div class="price-display">
    <div class="current-price">
      <span class="price-label">Price:</span>
      <span id="displayed-price" class="price-amount">$82.00</span>
    </div>
    <div id="price-breakdown" class="price-breakdown"></div>
  </div>

  <!-- Add to Cart Button -->
  <button type="submit" name="add" class="add-to-cart-button">
    Add to cart
  </button>

  <!-- Hidden inputs for Shopify -->
  <div style="display:none;">
    <input type="hidden" name="properties[Equipment]" id="equipment-input" value="None">
    <input type="hidden" name="properties[Cooler]" id="cooler-input" value="No">
    <input type="hidden" name="properties[Start Date]" id="start-date-input">
    <input type="hidden" name="properties[End Date]" id="end-date-input">
    <input type="hidden" name="properties[Duration]" id="duration-input" value="1">
    <input type="hidden" name="properties[Discount]" id="discount-input" value="0">
    <input type="hidden" name="properties[Base Price]" id="base-price-input" value="82.00">
    <input type="hidden" name="properties[Total Price]" id="total-price-input" value="82.00">
  </div>
  
  <!-- Product Features -->
  <div class="product-features">
    <ul>
      <li>2 Hour Continuous Run Time</li>
      <li>4 Wheel Drive & Steering</li>
      <li>All Terrain Vehicle</li>
      <li>Fits an umbrella, two chairs, and more.</li>
    </ul>
    <p class="tagline">Haul your beach going equipment in style.</p>
  </div>
</div>

<style>
