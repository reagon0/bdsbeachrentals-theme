{% comment %}
  Renders a simplified product media item (image only)
  Accepts:
  - media: {Object} Product Media object
{% endcomment %}

{%- if media.media_type == 'image' -%}
  <img
    class="product-single__image"
    src="{{ media.preview_image | image_url: width: 1100 }}"
    srcset="{{ media.preview_image | image_url: width: 400 }} 400w,
            {{ media.preview_image | image_url: width: 800 }} 800w,
            {{ media.preview_image | image_url: width: 1100 }} 1100w"
    sizes="(min-width: 750px) 700px, 100vw"
    alt="{{ media.alt | escape }}"
    loading="lazy"
    width="1100"
    height="{{ 1100 | divided_by: media.preview_image.aspect_ratio | ceil }}"
    data-media-id="{{ media.id }}"
  >
{%- else -%}
  {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
    <div class="product-single__media product-single__media--video">
      {{ media | media_tag: image_size: '800x', autoplay: false, loop: false, controls: true, preload: 'none' }}
    </div>
  {%- elsif media.media_type == 'model' -%}
    <div class="product-single__media product-single__media--model">
      {{ media | media_tag: image_size: '800x', toggleable: true }}
    </div>
  {%- endif -%}
{%- endif -%}