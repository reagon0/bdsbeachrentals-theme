    <!-- Product Image Fix Script -->
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        // Disable image zoom functionality and fix image sizing
        function fixProductImages() {
          // Remove zoom-related attributes
          const productImages = document.querySelectorAll('.product__media img, .product-featured-media');
          productImages.forEach(img => {
            img.removeAttribute('data-zoom');
            img.removeAttribute('data-image-zoom');
            img.removeAttribute('data-action');
            img.style.cursor = 'default';
          });
          
          // Hide zoom elements
          const zoomElements = document.querySelectorAll(
            '.product-zoom, .zoom-lightbox, .product__zoom-button, .product-image-zoom, ' +
            '[data-image-zoom="true"], [data-action="zoom"], .image-zoom-button'
          );
          
          zoomElements.forEach(el => {
            if (el) el.style.display = 'none';
          });
          
          // Fix main active image
          const mainImage = document.querySelector('.product__media-item.grid__item.is-active img');
          if (mainImage) {
            mainImage.style.objectFit = 'contain';
            mainImage.style.width = 'auto';
            mainImage.style.height = 'auto';
            mainImage.style.maxWidth = '100%';
            mainImage.style.maxHeight = '600px';
            mainImage.style.margin = '0 auto';
            
            // Make sure parent container is properly sized
            const mediaItem = mainImage.closest('.product__media-item');
            if (mediaItem) {
              mediaItem.style.display = 'flex';
              mediaItem.style.alignItems = 'center';
              mediaItem.style.justifyContent = 'center';
              mediaItem.style.minHeight = window.innerWidth < 750 ? '350px' : '600px';
              mediaItem.style.padding = '0';
              mediaItem.style.width = '100%';
            }
          }
          
          // Ensure thumbnails look good while staying small
          const thumbnails = document.querySelectorAll('.product__media-item:not(.is-active):not(:first-child)');
          thumbnails.forEach(thumbnail => {
            thumbnail.style.minHeight = 'auto';
            thumbnail.style.height = window.innerWidth < 750 ? '80px' : '100px';
            thumbnail.style.maxWidth = window.innerWidth < 750 ? '80px' : '100px';
            thumbnail.style.margin = '5px';
            
            const img = thumbnail.querySelector('img');
            if (img) {
              img.style.objectFit = 'cover';
              img.style.width = '100%';
              img.style.height = 'auto';
              img.style.maxHeight = window.innerWidth < 750 ? '80px' : '100px';
            }
          });
          
          // Make sure the first image (if not active) follows main image rules
          const firstImage = document.querySelector('.product__media-item.grid__item:first-child:not(.is-active) img');
          if (firstImage) {
            firstImage.style.objectFit = 'contain';
            firstImage.style.width = 'auto';
            firstImage.style.height = 'auto';
            firstImage.style.maxWidth = '100%';
            firstImage.style.maxHeight = window.innerWidth < 750 ? '350px' : '600px';
            
            const container = firstImage.closest('.product__media-item');
            if (container) {
              container.style.width = '100%';
              container.style.minHeight = window.innerWidth < 750 ? '350px' : '500px';
              container.style.display = 'flex';
              container.style.alignItems = 'center';
              container.style.justifyContent = 'center';
            }
          }
          
          // Adjust the thumbnail slider if it exists
          const thumbnailSlider = document.querySelector('#GalleryThumbnails-template--15084987736131__main');
          if (thumbnailSlider) {
            const thumbnailItems = thumbnailSlider.querySelectorAll('.thumbnail-list__item');
            thumbnailItems.forEach(item => {
              item.style.width = 'auto';
              item.style.maxWidth = '100px';
              item.style.height = '100px';
              
              const thumbImg = item.querySelector('img');
              if (thumbImg) {
                thumbImg.style.objectFit = 'cover';
                thumbImg.style.maxHeight = '100%';
                thumbImg.style.maxWidth = '100%';
              }
            });
          }
        }
        
        // Run initially
        fixProductImages();
        
        // Run after a delay to catch any images loaded later
        setTimeout(fixProductImages, 500);
        
        // Run again after everything is fully loaded
        window.addEventListener('load', fixProductImages);
        
        // Handle thumbnail clicks
        const thumbnailButtons = document.querySelectorAll('.thumbnail');
        thumbnailButtons.forEach(button => {
          button.addEventListener('click', () => {
            // Need to wait for the slide change to complete
            setTimeout(fixProductImages, 100);
            setTimeout(fixProductImages, 500); // Run again after a longer delay to be sure
          });
        });
        
        // Create a mutation observer to watch for DOM changes
        const observer = new MutationObserver(mutations => {
          // Check if any mutations affected product images
          const needsUpdate = mutations.some(mutation => {
            return Array.from(mutation.addedNodes).some(node => {
              return node.nodeType === 1 && (
                node.classList && (
                  node.classList.contains('product__media-item') ||
                  node.classList.contains('product__media') ||
                  node.classList.contains('is-active')
                ) || 
                node.querySelector && node.querySelector('.product__media-item, .product__media, .is-active')
              );
            });
          });
          
          if (needsUpdate) {
            fixProductImages();
          }
        });
        
        // Start observing the document
        observer.observe(document.body, { 
          childList: true, 
          subtree: true,
          attributes: true,
          attributeFilter: ['class']
        });
        
        // Also handle window resize events
        window.addEventListener('resize', fixProductImages);
      });
    </script>
  </body>
</html>